
#include <stdio.h>
#include <ctype.h>

int main()
{
    char text[100];
    int key[100], i, j = 0;

    printf("Enter plaintext: ");
    fgets(text, sizeof(text), stdin);

    printf("Enter numeric key values: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
            scanf("%d", &key[j++]);
    }

    j = 0;
    printf("Encrypted text: ");

    for(i = 0; text[i] != '\0'; i++)
    {
        if(isalpha(text[i]))
        {
            char ch = toupper(text[i]);
            printf("%c", (ch - 'A' + key[j++]) % 26 + 'A');
        }
        else
            printf("%c", text[i]);
    }

    printf("\n");
    return 0;
}


Input:
Enter plaintext: HELLO
Enter numeric key values: 3 19 5 11 7

Output:
Encrypted text: KXQWV
