
#include <stdio.h>
#include <math.h>

int main()
{
    double keys, uniqueKeys;
    double log2Keys;

    keys = tgamma(26);

    log2Keys = log(keys) / log(2);

    uniqueKeys = keys / (25 * 24 * 2);

    printf("Total possible keys = 26!\n");
    printf("Approximate power of 2 = 2^%.2f\n", log2Keys);

    printf("\nEffectively unique keys:\n");
    printf("26! / (25 * 24 * 2)\n");
    printf("Approximate power of 2 = 2^%.2f\n",
           log2(uniqueKeys));

    return 0;
}


