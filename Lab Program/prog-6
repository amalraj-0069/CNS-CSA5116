
#include <stdio.h>

int main() {
    int a, b, i, j, found = 0;

    // E = 4, T = 19, B = 1, U = 20
    for (a = 1; a < 26; a++) {
        if (a % 2 == 0 || a == 13)
            continue;

        for (b = 0; b < 26; b++) {
            if ((a * 4 + b) % 26 == 1 &&
                (a * 19 + b) % 26 == 20) {

                printf("Key a = %d\n", a);
                printf("Key b = %d\n", b);
                found = 1;
            }
        }
    }

    if (!found)
        printf("No valid key found");

    return 0;
}

