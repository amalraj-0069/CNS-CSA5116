#include <stdio.h>
#include <string.h>
#include <ctype.h>
char matrix[5][5];
void createMatrix(char key[]) {
    int used[26] = {0}, i, j, k = 0;
    char str[100] = "";
    strcat(str, key);
    strcat(str, "ABCDEFGHIKLMNOPQRSTUVWXYZ");
    used['J' - 'A'] = 1;
    for (i = 0; str[i] != '\0'; i++) {
        char ch = toupper(str[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z' && !used[ch - 'A']) {
            matrix[k / 5][k % 5] = ch;
            used[ch - 'A'] = 1;
            k++;
        }
    }
}
void find(char ch, int *r, int *c) {
    int i, j;
    for (i = 0; i < 5; i++)
        for (j = 0; j < 5; j++)
            if (matrix[i][j] == ch) {
                *r = i;
                *c = j;
                return;
            }
}
int main() {
    char key[100], text[100], plain[200] = "";
    int i, j, r1, c1, r2, c2, n = 0;
    printf("Enter keyword: ");
    scanf("%99s", key);
    printf("Enter plaintext: ");
    scanf("%99s", text);
    createMatrix(key);
    for (i = 0; text[i]; i++) {
        char ch = toupper(text[i]);
        if (ch == 'J') ch = 'I';
        if (ch >= 'A' && ch <= 'Z')
            plain[n++] = ch;
    }
    printf("\nEncrypted text: ");
    for (i = 0; i < n;) {
        char a = plain[i++];
        char b = (i < n && plain[i] != a) ? plain[i++] : 'X';
        if (a == b) b = 'Q';
        find(a, &r1, &c1);
        find(b, &r2, &c2);
        if (r1 == r2) {
            c1 = (c1 + 1) % 5;
            c2 = (c2 + 1) % 5;
        }
        else if (c1 == c2) {
            r1 = (r1 + 1) % 5;
            r2 = (r2 + 1) % 5;
        }
        else {
            j = c1;
            c1 = c2;
            c2 = j;
        }
        printf("%c%c", matrix[r1][c1], matrix[r2][c2]);
    }
    return 0;
}

